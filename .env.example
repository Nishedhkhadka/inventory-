# Copy this file to .env and fill in real values. Never commit .env itself.

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://localhost:27017/zeno

# Port the API server listens on
PORT=5000

# Comma-separated list of origins allowed to call the API
CLIENT_ORIGIN=http://localhost:5173

# ── Authentication ────────────────────────────────────────────────
# Long random string used to sign login sessions (JWTs). Generate one
# with: openssl rand -hex 32
# Changing this later invalidates every existing logged-in session.
JWT_SECRET=

# Used ONLY by `npm run seed:admin` to create the first admin account —
# read once, hashed with bcrypt, and stored in MongoDB. Remove these two
# lines from your real .env immediately after running the seed script;
# they are never read again afterward, and login always checks the
# database from then on, never these values.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ── Optional integrations ──────────────────────────────────────────
# Pick & Drop courier status lookups (leave blank if not using this)
PICKNDROP_BASE_URL=
PICKNDROP_API_KEY=
PICKNDROP_API_SECRET=

# OCR for packaging verification — omit to fall back to the local
# Tesseract engine (weaker on handwriting, but free and offline)
OPENAI_API_KEY=
